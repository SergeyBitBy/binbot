# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Default Admin Security Credentials (Section 139)
INITIAL_ADMIN_USERNAME=sergebybitp2p
INITIAL_ALLOWED_CHAT_ID=930460307

# System Settings
TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO

# Reliability and rate limiting
BINANCE_MAX_PAGES=50
BINANCE_DETAIL_CONCURRENCY=5
BINANCE_DETAIL_REFRESH_MINUTES=30
MONITORING_DISPATCH_INTERVAL_SECONDS=5
MONITORING_MAX_CONCURRENCY=3
MONITORING_LEASE_SECONDS=300
NOTIFICATION_MAX_ATTEMPTS=10
LOG_RETENTION_DAYS=30
LOG_MAX_FILE_MB=10
LOG_MAX_TOTAL_MB=100
BACKUP_RETENTION_COUNT=14

# Database Configuration (SQLite by default, PostgreSQL ready)
# Example SQLite: sqlite+aiosqlite:///./data/bot.db
# Example PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/binance_bot
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Optional Google Sheets Integration
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=data/google_credentials.json
GOOGLE_SPREADSHEET_ID=
